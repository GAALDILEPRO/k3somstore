{
  "name": "k3somstore-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "K3SOMSTORE E-Commerce Platform - Two-compartment architecture (Frontend & Backend)",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"green,blue\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"green,blue\" \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "npm run start --prefix backend",
    "start:frontend": "npm run start --prefix frontend",
    "build": "npm run build --prefix frontend",
    "seed": "npm run seed --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
